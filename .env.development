# ============================================================================
# 玄镜前端 · 本地开发环境（npm run dev 自动加载，NODE_ENV=development）
#
# 本文件已提交到仓库，供团队「克隆即用」，只放非敏感的地址类配置。
# 需要本地私有覆盖时，把同名变量写进 .env.local（被 gitignore，优先级更高）。
#
# ⚠️ NEXT_PUBLIC_* 是「构建期内联」变量：
#    - 改本文件后必须重启 dev（`npm run dev:kill` → `npm run dev:daemon`）
#    - Vercel 上改面板变量后必须重新部署（Redeploy），否则拿到的还是旧值
# ============================================================================

# ---- 后端排盘服务（oraclemind-backend）----
# 填域名根路径，不含 /api；请求路径由 src/lib/api.ts 拼成 ${API_BASE}/api/v1/...
# 本地后端标准端口 8000（观爻已释放 8000，玄镜后端回归标准端口）
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- AI 解读服务（oraclemind-ai-py）----
# 端口迁移史（沙箱孤儿端口无法回收，只能迁新端口）：
#   8002/8003 → 8007 → 8008 → 8012 → 8014 → 8015 → 8019 → 8021
# 8021：修「报告页推演过程出现原始 JSON」—— report_agent 三阶段改为解析后推可读摘要。
# 改动本端口后必须同步 oraclemind-ai-py/.env(.development) 的 PORT 并重启 AI 服务。
NEXT_PUBLIC_AI_API_BASE=http://localhost:8021

# ---- iconfont CDN（font-class 模式）----
# 不配也能用：src/app/layout.tsx 内置了同一条线上 CDN 作为代码级默认。
# 仅当更换图标库 / 自托管样式表时才覆盖。
NEXT_PUBLIC_ICONFONT_CDN=https://at.alicdn.com/t/c/font_5225625_q91x1qydrn.css

# ---- 随喜支付收款码 ----
# 留空则用代码默认 public/images/pay/wechat-qr.png（见 src/lib/premium.ts）
NEXT_PUBLIC_PAY_QR_URL=
