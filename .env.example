# ============================================================================
# 玄镜前端环境变量说明（本文件仅作索引，不参与加载）
#
# Next.js 按 NODE_ENV 自动选择加载哪个文件，无需手工切换：
#   npm run dev      →  NODE_ENV=development  →  .env.development（本机服务地址）
#   npm run build    →  NODE_ENV=production   →  .env.production（线上域名）
#   Vercel 构建      →  NODE_ENV=production   →  .env.production（面板变量再覆盖它）
#
# 加载优先级（高 → 低）：
#   1. Vercel 项目面板 / 终端真实环境变量
#   2. .env.<NODE_ENV>.local   （个人覆盖，gitignore）
#   3. .env.local               （个人覆盖，gitignore）
#   4. .env.<NODE_ENV>          （本仓库提交：.env.development / .env.production）
#   5. .env                     （个人兜底，gitignore）
#
# 日常只需要改 .env.development / .env.production 两个文件，它们已提交到仓库。
# ============================================================================

# ---- 后端排盘计算服务（oraclemind-backend FastAPI）----
# 填域名根路径，不含 /api；请求路径由 src/lib/api.ts 拼成 ${API_BASE}/api/v1/...
# 开发：http://localhost:8000   生产：https://oraclemind-backend.vercel.app
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---- AI 解读服务（oraclemind-ai-py FastAPI，独立 Vercel 项目）----
# 同理填域名根路径，请求走 ${AI_BASE}/api/v1/...
# 开发：http://localhost:8021   生产：https://oraclemind-ai-eight.vercel.app
NEXT_PUBLIC_AI_API_BASE=http://localhost:8021

# ---- iconfont CDN（font-class 模式）----
# 可选：src/app/layout.tsx 已内置同一条线上 CDN 作为代码级默认
NEXT_PUBLIC_ICONFONT_CDN=https://at.alicdn.com/t/c/font_5225625_q91x1qydrn.css

# ---- 随喜支付收款码（可选）----
# 留空则用代码默认 public/images/pay/wechat-qr.png（见 src/lib/premium.ts）
NEXT_PUBLIC_PAY_QR_URL=

# ---- 站点自身地址（仅生产需要，用于绝对链接 / OG）----
NEXT_PUBLIC_SITE_URL=https://oraclemind-frontend.vercel.app
