{
  "name": "oraclemind",
  "version": "1.0.0",
  "private": true,
  "description": "玄镜 OracleMind - 玄学综合服务平台（Next.js 14 工程化迁移版）",
  "scripts": {
    "dev": "node scripts/next.js dev",
    "dev:daemon": "node scripts/next.js dev --daemon",
    "dev:clean": "node scripts/next.js dev --clean --force",
    "dev:kill": "node scripts/next.js kill",
    "dev:unsafe": "next dev",
    "build": "node scripts/next.js build",
    "start": "node scripts/next.js start",
    "lint": "node scripts/next.js lint",
    "verify:tarot": "node --experimental-strip-types scripts/tarot-verify.ts"
  },
  "dependencies": {
    "cnchar": "^3.2.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lunar-typescript": "^1.8.6",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "sass": "^1.77.8",
    "typescript": "^5.5.0"
  }
}
