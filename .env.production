# ============================================================================
# 玄镜前端 · 生产环境（Vercel 构建时自动加载，NODE_ENV=production）
#
# 本文件已提交到仓库，是生产部署的「兜底默认值」：
#   Vercel 项目面板里配的同名变量优先级更高，会覆盖这里的取值。
#   所以这里只写「地址类、不敏感、几乎不变」的配置，密钥一律不放。
#
# ⚠️ NEXT_PUBLIC_* 是「构建期内联」变量：改完必须 Redeploy 才会生效。
# ============================================================================

# ---- 后端排盘服务（oraclemind-backend 的 Vercel 项目域名）----
# 已上线：2026-09-15 实测 GET /api/health → 200 {"status":"degraded","database":"up"}
# 填域名根路径，不含 /api；请求路径由 src/lib/api.ts 拼成 ${API_BASE}/api/v1/...
NEXT_PUBLIC_API_BASE=https://oraclemind-backend.vercel.app

# ---- AI 解读服务（oraclemind-ai-py 的 Vercel 项目域名）----
NEXT_PUBLIC_AI_API_BASE=https://oraclemind-ai-eight.vercel.app

# ---- iconfont CDN（font-class 模式）----
NEXT_PUBLIC_ICONFONT_CDN=https://at.alicdn.com/t/c/font_5225625_q91x1qydrn.css

# ---- 随喜支付收款码 ----
# 留空则用代码默认 public/images/pay/wechat-qr.png
NEXT_PUBLIC_PAY_QR_URL=

# ---- 站点自身地址（用于 OG / 绝对链接）----
NEXT_PUBLIC_SITE_URL=https://oraclemind-frontend.vercel.app
